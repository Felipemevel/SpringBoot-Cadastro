# Standard .gitignore for Spring Boot Projects with IntelliJ IDEA & Maven/Gradle
# Generated for Felipe - Academic & Professional Development
# =========================================================================

# --- IDE Specific Files (IntelliJ IDEA) ---
.idea/
*.iml
*.iws
*.ipr
out/
.project
.classpath
.settings/
.factorypath

# --- Build Tool Artifacts (Maven) ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Note: It is usually recommended to keep .mvn/wrapper/maven-wrapper.properties 
# and .mvn/wrapper/maven-wrapper.jar if you want others to build with the same Maven version.
# If you want to ignore the whole wrapper, uncomment the line below:
# .mvn/

# --- Build Tool Artifacts (Gradle) ---
.gradle/
build/
/captcha/
.modules/

# --- Compiled Java Files ---
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Log Files ---
logs/
*.log
logback.log

# --- OS Specific Files (Linux/Fedora & Windows) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Environment & Sensitive Variables ---
.env
.env.local
.env.*.local
*.properties.local
*.yml.local
*.yaml.local

# --- Crash dumps & Temp Files ---
*.ipch
*.aps
*.ncb
*.lines
*.suo
*.user
*.userosscache
*.sln.docstates
"""
